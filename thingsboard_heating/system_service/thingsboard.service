[Unit]
Description=ThingsBoard IoT Platform Service
After=network.target
After=postgresql.service

[Service]
User=root
WorkingDirectory=/home/test/thingsboard
# Санах ойн хэмжээг өөрийн серверт тааруулах (-Xms=Эхлэх хэмжээ, -Xmx=Хамгийн их хэмжээ)
ExecStart=/usr/bin/java -Xms1024M -Xmx2048M -jar /home/test/thingsboard/application/target/thingsboard-4.3.1.3-boot.jar
SuccessExitStatus=143
Restart=always
RestartSec=10

# ThingsBoard-ийн лог файлууд хадгалагдах зам
Environment=TB_LOG_PATH=/home/ubuntu/app/logs

[Install]
WantedBy=multi-user.target

